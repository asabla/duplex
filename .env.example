# Select one complete example: compose.yaml or compose.plex.yaml.
COMPOSE_FILE=compose.yaml
# This is a prepared directory on the Linux Docker daemon host.
DUPLEX_HOST_DIR=/var/lib/duplex
DUPLEX_PORT=8765
# Used only by compose.plex.yaml.
PLEX_PORT=32499
TZ=Etc/UTC
# Keep passwords and Plex tokens in protected files, never in this file.
