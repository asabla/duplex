[Unit]
Description=duplex YouTube library for Plex
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=duplex
Group=duplex
UMask=0077
ExecStart=/usr/local/bin/duplex serve --config /etc/duplex/config.yaml --nfs-listen 127.0.0.1:2049
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/duplex /etc/duplex
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
